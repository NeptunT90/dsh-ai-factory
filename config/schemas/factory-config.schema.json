{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dsh-ai-factory/dsh-ai-factory/config/factory-config.schema.json",
  "title": "DSH AI Factory plugin configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean", "default": true },
    "dataDir": {
      "type": "string",
      "default": "",
      "description": "Empty = ~/.dsh/ai-factory; ~ and %VARS% are expanded; relative paths resolve against ~/.dsh"
    },
    "dbFile": { "type": "string", "default": "factory.db", "pattern": "^[^/\\\\]+$" },
    "maxSearchResults": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
    "workingMemoryTtlHours": { "type": "number", "minimum": 0, "maximum": 8760, "default": 72 },
    "maxContentChars": { "type": "integer", "minimum": 100, "maximum": 1000000, "default": 100000 },
    "defaultAutonomy": { "enum": ["safe", "autonomous", "trusted"], "default": "autonomous" },
    "allowGlobalMemory": { "type": "boolean", "default": true },
    "projectIdOverride": { "type": "string", "default": "" },
    "redactLogs": { "type": "boolean", "default": true },
    "logLevel": { "enum": ["debug", "info", "warn", "error"], "default": "info" },
    "syncUrl": { "type": "string", "default": "", "description": "Optional sync server URL; HTTPS or loopback HTTP" },
    "syncTokenEnv": { "type": "string", "default": "DSH_AI_FACTORY_SYNC_TOKEN" },
    "syncDeviceId": { "type": "string", "default": "" },
    "syncBatchSize": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
    "syncTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 60000, "default": 15000 },
    "syncAuto": { "type": "boolean", "default": false },
    "syncIntervalSeconds": { "type": "integer", "minimum": 15, "maximum": 86400, "default": 60 },
    "modelRouterEnabled": { "type": "boolean", "default": true },
    "modelFallbacks": { "type": "string", "default": "", "description": "comma-separated provider/model routes" },
    "modelMaxAttempts": { "type": "integer", "minimum": 1, "maximum": 3, "default": 2 }
  }
}
