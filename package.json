{
  "name": "dsh-ai-factory-repo",
  "version": "0.27.0",
  "private": true,
  "description": "DSH AI Factory — autonomous multi-agent platform for DeepSeek Harness",
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "pnpm --filter dsh-ai-factory build",
    "typecheck": "pnpm --filter dsh-ai-factory typecheck",
    "test": "pnpm --filter dsh-ai-factory test",
    "server:typecheck": "pnpm --filter @dsh-ai-factory/sync-server typecheck",
    "server:test": "pnpm --filter @dsh-ai-factory/sync-server build && pnpm --filter @dsh-ai-factory/sync-server test",
    "verify": "pnpm typecheck && pnpm test && pnpm server:typecheck && pnpm server:test && pnpm build",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "server:build": "pnpm --filter @dsh-ai-factory/sync-server build"
  }
}
